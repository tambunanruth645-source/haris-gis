# ===================================================
# HARIS GIS - ENVIRONMENT VARIABLES TEMPLATE
# ===================================================

# Database Settings (PostgreSQL + PostGIS)
POSTGRES_USER=haris_admin
POSTGRES_PASSWORD=haris_secret_password
POSTGRES_DB=haris_gis
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://haris_admin:haris_secret_password@localhost:5432/haris_gis

# Martin Vector Tile Server
MARTIN_PORT=3000

# Redis Cache & Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ROOT_USER=haris_minio_admin
MINIO_ROOT_PASSWORD=haris_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=haris-gis-uploads

# JWT Security
JWT_SECRET_KEY=super_secret_jwt_key_haris_gis_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
APP_ENV=development
APP_PORT=8000
CLIENT_PORT=5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
